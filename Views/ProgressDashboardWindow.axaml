<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="QARegressionManager.Views.ProgressDashboardWindow"
    Title="{DynamicResource Dashboard.WindowTitle}"
    Width="980"
    Height="780"
    MinWidth="760"
    MinHeight="600"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppBackgroundBrush}">

    <Border Margin="20" Padding="26"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="22">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="Dashboard"
                               FontSize="{DynamicResource AppFontSize25}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="{DynamicResource Common.AssignedProgress}"
                               FontSize="{DynamicResource AppFontSize13}" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Name="DashboardDescriptionTextBlock"
                               IsVisible="False"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Spacing="10">
                    <Border Width="58" Height="58"
                            Background="#162E86D1"
                            BorderBrush="#6EA8DE"
                            BorderThickness="1"
                            CornerRadius="18">
                        <Path Width="30" Height="30"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Stroke="#2E86D1"
                              StrokeThickness="1.7"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Fill="Transparent"
                              Data="M 2,21 L 22,21 M 4,19 L 4,13 L 8,13 L 8,19 M 10,19 L 10,10 L 14,10 L 14,19 M 16,19 L 16,5 L 20,5 L 20,19 M 4,11 L 10,7 L 14,9 L 21,2 M 18,2 L 21,2 L 21,5" />
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,14,0,6" ColumnDefinitions="*,12,*,12,*">
                <Border Grid.Column="0" Padding="14,8" Background="#142878D0" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard.Sessions}" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold" Foreground="#2878D0" />
                        <TextBlock Name="SessionsCountTextBlock" Text="0" FontSize="{DynamicResource AppFontSize22}" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="14,8" Background="#1428C76F" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard.Completed}" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold" Foreground="#159454" />
                        <TextBlock Name="CompletedCountTextBlock" Text="0" FontSize="{DynamicResource AppFontSize22}" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Padding="14,8" Background="#14F0A34A" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard.Remaining}" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold" Foreground="#C26A10" />
                        <TextBlock Name="RemainingCountTextBlock" Text="0" FontSize="{DynamicResource AppFontSize22}" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Name="TeamOverviewPanel" Grid.Row="2" Margin="0,6,0,4"
                    Padding="12" CornerRadius="14"
                    Background="{DynamicResource IconBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" IsVisible="False">
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" ColumnSpacing="14">
                    <Canvas Name="TeamPieChartCanvas" Width="150" Height="150"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="{DynamicResource Dashboard.TeamProgress}" FontSize="{DynamicResource AppFontSize17}" FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource Dashboard.TeamProgressDescription}"
                                   TextWrapping="Wrap" FontSize="{DynamicResource AppFontSize12}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <WrapPanel Name="TeamLegendPanel" Margin="0,6,0,0"
                                   Orientation="Horizontal" />
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="4,7,4,0"
                          RowDefinitions="Auto,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource Dashboard.TeamCompletion}"
                                       FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" />
                            <TextBlock Name="TeamCompletionPercentTextBlock"
                                       Grid.Column="1" Text="0%"
                                       FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold"
                                       Foreground="#159454" />
                        </Grid>
                        <ProgressBar Name="TeamCompletionProgressBar"
                                     Grid.Row="1" Margin="0,5,0,0"
                                     Minimum="0" Maximum="100" Value="0"
                                     Height="7" Foreground="#28C76F" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Name="ManagerNavigationPanel" Grid.Row="3" Margin="0,8,0,0"
                  ColumnDefinitions="Auto,8,Auto,8,Auto,*,Auto,8,Auto,8,Auto" IsVisible="False">
                <Button Name="ActiveSessionsButton" Grid.Column="0" Height="38" Padding="16,0"
                        Content="{DynamicResource Dashboard.Active}" Click="ActiveSessionsButton_OnClick"
                        Background="#2E86D1" Foreground="White" BorderBrush="#2E86D1" />
                <Button Name="HistorySessionsButton" Grid.Column="2" Height="38" Padding="16,0"
                        Content="{DynamicResource Dashboard.History}" Click="HistorySessionsButton_OnClick" />
                <Button Name="ArchiveSessionsButton" Grid.Column="4" Height="38" Padding="16,0"
                        Content="{DynamicResource Dashboard.Archive}" Click="ArchiveSessionsButton_OnClick" />
                <Button Name="StopSelectedSessionsButton" Grid.Column="6" Height="38" Padding="16,0"
                        Content="{DynamicResource Dashboard.StopSelected}" Click="StopSelectedSessionsButton_OnClick"
                        Background="#DC4C56" Foreground="White" BorderBrush="#DC4C56"
                        IsEnabled="False" />
                <Button Name="RestoreArchivedSessionsButton" Grid.Column="8" Height="38" Padding="16,0"
                        Content="{DynamicResource Dashboard.RestoreSelected}" Click="RestoreArchivedSessionsButton_OnClick"
                        Background="#2E86D1" Foreground="White" BorderBrush="#2E86D1"
                        IsVisible="False" IsEnabled="False" />
                <Button Name="DeleteAllArchivedSessionsButton" Grid.Column="10" Height="38" Padding="16,0"
                        Content="{DynamicResource Dashboard.DeleteAll}" Click="DeleteAllArchivedSessionsButton_OnClick"
                        Background="#B93643" Foreground="White" BorderBrush="#B93643"
                        IsVisible="False" />
            </Grid>

            <ScrollViewer Grid.Row="4" Margin="0,8,0,10" VerticalScrollBarVisibility="Auto">
                <StackPanel Name="AssignmentsPanel" Spacing="7" />
            </ScrollViewer>

            <Grid Grid.Row="5" ColumnDefinitions="*,Auto,10,Auto">
                <Button Name="GenerateTeamReportButton" Grid.Column="1"
                        Height="44" Padding="22,0"
                        Background="#4D91D1" BorderBrush="#75A9D8"
                        Foreground="White" FontWeight="Bold"
                        Content="{DynamicResource Dashboard.GenerateReport}" IsVisible="False"
                        Click="GenerateTeamReportButton_OnClick" />
                <Button Grid.Column="3" HorizontalAlignment="Right" Height="44" Padding="24,0"
                        Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" FontWeight="Bold"
                        Content="{DynamicResource Common.Close}" Click="CloseButton_OnClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
