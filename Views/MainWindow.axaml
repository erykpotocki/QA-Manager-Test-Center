<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:QARegressionManager.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1320"
    d:DesignHeight="820"
    x:Class="QARegressionManager.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Icon="/Assets/AppIcon/QAM.ico"
    Title="QA Manager"
    Width="1320"
    Height="820"
    MinWidth="1000"
    MinHeight="680"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource AppBackgroundBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>

        <!-- POLA TEKSTOWE -->

        <Style Selector="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="CornerRadius" Value="10" />

            <Setter
                Property="Background"
                Value="{DynamicResource InputBackgroundBrush}" />

            <Setter
                Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}" />

            <Setter
                Property="CaretBrush"
                Value="{DynamicResource PrimaryTextBrush}" />

            <Setter
                Property="SelectionBrush"
                Value="{DynamicResource SelectionBrush}" />

            <Setter
                Property="SelectionForegroundBrush"
                Value="{DynamicResource PrimaryTextBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{DynamicResource InputBorderBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
        </Style>

        <Style Selector="TextBox:pointerover">

            <Setter
                Property="Background"
                Value="{DynamicResource InputBackgroundBrush}" />

            <Setter
                Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{DynamicResource InputHoverBorderBrush}" />

        </Style>

        <Style Selector="TextBox:focus">

            <Setter
                Property="Background"
                Value="{DynamicResource InputBackgroundBrush}" />

            <Setter
                Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{DynamicResource InputFocusBorderBrush}" />

            <Setter Property="BorderThickness" Value="2" />

        </Style>

        <!-- LISTA PROJEKTÓW -->

        <Style Selector="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="10" />

            <Setter
                Property="Background"
                Value="{DynamicResource InputBackgroundBrush}" />

            <Setter
                Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{DynamicResource InputBorderBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
        </Style>

        <Style Selector="ComboBox:pointerover">

            <Setter
                Property="Background"
                Value="{DynamicResource InputBackgroundBrush}" />

            <Setter
                Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{DynamicResource InputHoverBorderBrush}" />

        </Style>

        <Style Selector="ComboBox:focus">

            <Setter
                Property="Background"
                Value="{DynamicResource InputBackgroundBrush}" />

            <Setter
                Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{DynamicResource InputFocusBorderBrush}" />

            <Setter Property="BorderThickness" Value="2" />

        </Style>

        <Style Selector="ComboBoxItem">

            <Setter
                Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}" />

            <Setter
                Property="Background"
                Value="{DynamicResource InputBackgroundBrush}" />

            <Setter Property="Padding" Value="12,9" />

        </Style>

        <Style Selector="ComboBoxItem:pointerover">

            <Setter
                Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}" />

            <Setter
                Property="Background"
                Value="{DynamicResource HoverItemBrush}" />

        </Style>

        <Style Selector="ComboBoxItem:selected">

            <Setter
                Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}" />

            <Setter
                Property="Background"
                Value="{DynamicResource SelectedItemBrush}" />

        </Style>

        <!-- PRZYCISK ROZPOCZĘCIA -->

        <Style Selector="Button.StartButton">
            <Setter Property="Width" Value="320" />
            <Setter Property="Height" Value="112" />
            <Setter Property="Margin" Value="0,24,0,18" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter
                Property="HorizontalContentAlignment"
                Value="Center" />

            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">

                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

                    </Border>
                </ControlTemplate>
            </Setter>

        </Style>

        <Style Selector="Button.StartButton:pointerover">
            <Setter Property="Background" Value="#3AD47A" />
            <Setter Property="BorderBrush" Value="#3AD47A" />
        </Style>

        <Style Selector="Button.StartButton:pressed">
            <Setter Property="Background" Value="#169B50" />
            <Setter Property="BorderBrush" Value="#169B50" />
        </Style>

        <!-- PRZYCISK MOTYWU -->

        <Style Selector="Button.ThemeButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />

            <Setter
                Property="Background"
                Value="{DynamicResource ThemeButtonBackgroundBrush}" />

            <Setter
                Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{DynamicResource InputBorderBrush}" />

            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter
                Property="HorizontalContentAlignment"
                Value="Center" />

            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

                    </Border>
                </ControlTemplate>
            </Setter>

        </Style>

        <Style Selector="Button.ThemeButton:pointerover">

            <Setter
                Property="Background"
                Value="{DynamicResource ThemeButtonHoverBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{DynamicResource InputHoverBorderBrush}" />

        </Style>

        <Style Selector="Button.ThemeButton:pressed">

            <Setter
                Property="Background"
                Value="{DynamicResource ThemeButtonPressedBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{DynamicResource InputFocusBorderBrush}" />

        </Style>

        <Style Selector="Button.SettingsMenuItem">
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.SettingsMenuItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverItemBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
        </Style>

        <Style Selector="Button.AssignmentAttentionButton">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:1.35" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:1.35" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.LogoutButton">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="14,0" />
            <Setter
                Property="Background"
                Value="{DynamicResource ThemeButtonBackgroundBrush}" />
            <Setter
                Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}" />
            <Setter
                Property="BorderBrush"
                Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.LogoutButton:pointerover">
            <Setter
                Property="Background"
                Value="{DynamicResource ThemeButtonHoverBrush}" />
            <Setter
                Property="BorderBrush"
                Value="{DynamicResource InputHoverBorderBrush}" />
        </Style>

        <Style Selector="Button.LanguagePicker">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.LanguageOption">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="FlyoutPresenter.LanguageFlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Styles>

    <Grid>

        <Border
            Name="RefreshIndicatorBorder"
            Width="38"
            Height="38"
            Margin="0,80,22,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsVisible="False"
            Background="{DynamicResource IconBackgroundBrush}"
            BorderBrush="{DynamicResource InputBorderBrush}"
            BorderThickness="1"
            CornerRadius="11"
            ToolTip.Tip="{DynamicResource Common.RefreshingData}">
            <TextBlock Name="RefreshIndicatorIcon" Text="↻" FontSize="{DynamicResource AppFontSize22}" Foreground="#2878D0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderTransformOrigin="50%,50%">
                <TextBlock.RenderTransform>
                    <RotateTransform />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Border>

        <!-- TŁO -->

        <Ellipse
            Width="420"
            Height="420"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="-180,-190,0,0"
            Fill="{DynamicResource DecorationOneBrush}"
            IsHitTestVisible="False" />

        <Ellipse
            Width="360"
            Height="360"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,-150,-180"
            Fill="{DynamicResource DecorationTwoBrush}"
            IsHitTestVisible="False" />

        <!-- MOTYW -->

        <Button
            Name="NotificationCenterButton"
            Classes="ThemeButton"
            IsVisible="False"
            ClipToBounds="False"
            Margin="0,22,118,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Click="NotificationCenterButton_OnClick">

            <Grid Width="42" Height="42" ClipToBounds="False">
                <TextBlock Text="🔔" FontSize="{DynamicResource AppFontSize18}" />
                <Border Name="NotificationBadgeBorder" MinWidth="20" Height="20"
                        Padding="5,0" Margin="0,-7,-6,0" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Background="#DC4C56" CornerRadius="10"
                        IsVisible="False">
                    <TextBlock Name="NotificationBadgeTextBlock" Text="0" FontSize="{DynamicResource AppFontSize10}"
                               FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>

        </Button>

        <Button Name="ThemeToggleButton" Classes="ThemeButton" Margin="0,22,70,0"
                Width="42" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                Click="ThemeToggleButton_OnClick">
            <TextBlock Name="ThemeIconTextBlock" Text="☾"
                       FontSize="{DynamicResource AppFontSize20}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
        </Button>

        <Button Name="LanguagePickerButton" Classes="LanguagePicker"
                Margin="0,22,22,0" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Border Width="30" Height="30" CornerRadius="15" ClipToBounds="True"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid Name="CurrentPolishFlag" RowDefinitions="*,*">
                        <Border Grid.Row="0" Background="#FFFFFF" />
                        <Border Grid.Row="1" Background="#DC143C" />
                    </Grid>
                    <Canvas Name="CurrentEnglishFlag" Background="#21468B" IsVisible="False">
                        <Path Stroke="#FFFFFF" StrokeThickness="7" Data="M -4,1 L 34,29 M 34,1 L -4,29" />
                        <Path Stroke="#CF142B" StrokeThickness="3" Data="M -4,1 L 34,29 M 34,1 L -4,29" />
                        <Path Stroke="#FFFFFF" StrokeThickness="9" Data="M 15,0 L 15,30 M 0,15 L 30,15" />
                        <Path Stroke="#CF142B" StrokeThickness="4.5" Data="M 15,0 L 15,30 M 0,15 L 30,15" />
                    </Canvas>
                </Grid>
            </Border>
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="LanguageFlyoutPresenter">
                    <Border Width="184" Padding="10" Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14">
                        <StackPanel Spacing="7">
                            <TextBlock Text="{DynamicResource Language.Select}" Margin="3,1,3,2"
                                       FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Button Classes="LanguageOption" Click="PolishLanguageButton_OnClick">
                                <Grid ColumnDefinitions="40,*">
                                    <Border Width="32" Height="20" CornerRadius="3" ClipToBounds="True"
                                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                                        <Grid RowDefinitions="*,*">
                                            <Border Grid.Row="0" Background="#FFFFFF" />
                                            <Border Grid.Row="1" Background="#DC143C" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Polski" VerticalAlignment="Center"
                                               FontSize="{DynamicResource AppFontSize13}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Grid>
                            </Button>
                            <Button Classes="LanguageOption" Click="EnglishLanguageButton_OnClick">
                                <Grid ColumnDefinitions="40,*">
                                    <Border Width="32" Height="20" CornerRadius="3" ClipToBounds="True"
                                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                                        <Viewbox Stretch="Fill">
                                            <Canvas Width="32" Height="20" Background="#21468B">
                                                <Path Stroke="#FFFFFF" StrokeThickness="5" Data="M -3,0 L 35,20 M 35,0 L -3,20" />
                                                <Path Stroke="#CF142B" StrokeThickness="2" Data="M -3,0 L 35,20 M 35,0 L -3,20" />
                                                <Path Stroke="#FFFFFF" StrokeThickness="7" Data="M 16,0 L 16,20 M 0,10 L 32,10" />
                                                <Path Stroke="#CF142B" StrokeThickness="3.5" Data="M 16,0 L 16,20 M 0,10 L 32,10" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="English" VerticalAlignment="Center"
                                               FontSize="{DynamicResource AppFontSize13}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </Flyout>
            </Button.Flyout>
        </Button>
        <Button Name="ExecuteAssignedTestsButton" Classes="AssignmentAttentionButton" Width="145" Height="46"
                Margin="0,22,214,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="#1F6FBF" BorderBrush="#70A8DD" Foreground="White"
                CornerRadius="14" FontSize="{DynamicResource AppFontSize12}" FontWeight="SemiBold"
                Content="{DynamicResource Main.ExecuteTests}" IsVisible="False"
                Click="ExecuteAssignedTestsButton_OnClick" />

        <Button Name="ProgressDashboardButton" Classes="ThemeButton"
                IsVisible="False"
                Margin="0,22,166,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                ToolTip.Tip="{DynamicResource Common.AssignedProgress}"
                Click="ProgressDashboardButton_OnClick">
            <Path Width="23" Height="23"
                  Stretch="Uniform"
                  Stroke="{DynamicResource PrimaryTextBrush}"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Fill="Transparent"
                  Data="M 2,21 L 22,21 M 4,19 L 4,13 L 8,13 L 8,19 M 10,19 L 10,10 L 14,10 L 14,19 M 16,19 L 16,5 L 20,5 L 20,19 M 4,11 L 10,7 L 14,9 L 21,2 M 18,2 L 21,2 L 21,5" />
        </Button>

        <!-- GŁÓWNA KARTA -->

        <Border
            Width="570"
            Padding="54,38"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="28">

            <StackPanel Spacing="4">

                <Border
                    Width="64"
                    Height="64"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource IconBackgroundBrush}"
                    CornerRadius="20">

                    <TextBlock
                        Text="✓"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource AppFontSize34}"
                        FontWeight="Bold"
                        Foreground="#19944D" />

                </Border>

                <TextBlock
                    Text="QA Manager"
                    HorizontalAlignment="Center"
                    FontSize="{DynamicResource AppFontSize30}"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock
                    Text="{DynamicResource Main.PrepareSession}"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center"
                    FontSize="{DynamicResource AppFontSize14}"
                    Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock
                    Text="{DynamicResource Main.LoggedInUser}"
                    Margin="0,0,0,4"
                    FontSize="{DynamicResource AppFontSize12}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource SecondaryTextBrush}" />

                <Border
                    Height="44"
                    Padding="14,0"
                    Background="{DynamicResource IconBackgroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">

                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource Common.Refresh}" Click="RefreshButton_OnClick" />
                            <Separator />
                            <MenuItem Header="{DynamicResource Common.Logout}" Click="LogoutButton_OnClick" />
                        </ContextMenu>
                    </Border.ContextMenu>

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="9">

                        <Ellipse
                            Width="9"
                            Height="9"
                            Fill="#28C76F" />

                        <TextBlock
                            Name="LoggedInUserTextBlock"
                            Text="użytkownik"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource AppFontSize15}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}" />

                    </StackPanel>

                </Border>

                <ScrollViewer
                    Name="RoleBadgesScrollViewer"
                    Margin="0,8,0,0"
                    MaxWidth="440"
                    HorizontalAlignment="Left"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled">

                    <StackPanel
                        Name="RoleBadgesPanel"
                        Orientation="Horizontal"
                        Spacing="6" />

                </ScrollViewer>

                <TextBlock
                    Text="{DynamicResource Main.Project}"
                    Margin="0,12,0,4"
                    FontSize="{DynamicResource AppFontSize12}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource SecondaryTextBrush}" />

                <ComboBox
                    Name="ProjectComboBox"
                    SelectedIndex="0">

                    <ComboBoxItem Content="TEST PROJECT" />
                    <ComboBoxItem Content="TEST SANDBOX" />

                </ComboBox>

                <TextBlock Name="NoProjectMessageTextBlock" Margin="0,8,0,0"
                           Text="{DynamicResource Main.NoProject}"
                           TextWrapping="Wrap" FontSize="{DynamicResource AppFontSize12}" Foreground="#DC4C56"
                           IsVisible="False" />

                <Button
                    Name="StartTestButton"
                    Classes="StartButton"
                    HorizontalAlignment="Center">

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="5">

                        <Path
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Center"
                            Stretch="Uniform"
                            Fill="White"
                            Data="M 3,1 L 23,13 L 3,25 Z" />

                        <TextBlock
                            Text="{DynamicResource Main.Start}"
                            HorizontalAlignment="Center"
                            FontSize="{DynamicResource AppFontSize19}"
                            FontWeight="Bold"
                            Foreground="White" />

                        <TextBlock
                            Text="{DynamicResource Main.LoadTestCases}"
                            HorizontalAlignment="Center"
                            FontSize="{DynamicResource AppFontSize12}"
                            Foreground="#E8FFF0" />

                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>

        <!-- STOPKA -->

        <StackPanel
            Margin="0,0,0,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Spacing="2">

            <TextBlock
                Text="QA Manager • v0.2 • 2026"
                HorizontalAlignment="Center"
                FontSize="{DynamicResource AppFontSize11}"
                Foreground="{DynamicResource FooterTextBrush}" />

            <TextBlock
                Text="© 2026 Eryk Potocki"
                HorizontalAlignment="Center"
                FontSize="{DynamicResource AppFontSize10}"
                Foreground="{DynamicResource FooterSignatureBrush}" />

        </StackPanel>

    </Grid>

</Window>
