<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="QARegressionManager.Views.ContinueSessionWindow"
    Title="Niedokończona regresja"
    Width="620"
    Height="610"
    MinWidth="560"
    MinHeight="540"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppBackgroundBrush}">

    <Window.Styles>

        <Style Selector="Button.DialogButton">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.DialogButton.Secondary">
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.DialogButton.Secondary:pointerover">
            <Setter Property="Background"
                    Value="{DynamicResource HoverItemBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputHoverBorderBrush}" />
        </Style>

        <Style Selector="Button.DialogButton.Primary">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.DialogButton.Primary:pointerover">
            <Setter Property="Background" Value="#3AD47A" />
            <Setter Property="BorderBrush" Value="#3AD47A" />
        </Style>

        <Style Selector="Button.DialogButton.Primary:pressed">
            <Setter Property="Background" Value="#169B50" />
            <Setter Property="BorderBrush" Value="#169B50" />
        </Style>

        <Style Selector="TextBlock.MetadataLabel">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.MetadataValue">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Window.Styles>

    <Border
        Margin="20"
        Padding="28"
        Background="{DynamicResource CardBackgroundBrush}"
        BorderBrush="{DynamicResource CardBorderBrush}"
        BorderThickness="1"
        CornerRadius="22">

        <Grid RowDefinitions="Auto,*,Auto">

            <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Center"
                Spacing="8">

                <Border
                    Width="62"
                    Height="62"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource IconBackgroundBrush}"
                    CornerRadius="18">

                    <TextBlock
                        Text="↻"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource AppFontSize30}"
                        FontWeight="SemiBold"
                        Foreground="#19944D" />

                </Border>

                <TextBlock
                    Text="Wykryto niedokończoną regresję"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    FontSize="{DynamicResource AppFontSize24}"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock
                    Text="Masz przypisaną sesję testową, która nie została zakończona. Możesz wrócić dokładnie do ostatniego miejsca."
                    MaxWidth="500"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    FontSize="{DynamicResource AppFontSize14}"
                    LineHeight="21"
                    Foreground="{DynamicResource SecondaryTextBrush}" />

            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                Margin="0,22,0,18"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <StackPanel
                    Margin="0,0,8,0"
                    Spacing="14">

                    <Border
                        Padding="18"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">

                        <Grid
                            ColumnDefinitions="150,*"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="MetadataLabel" Margin="0,0,18,12" Text="Projekt" />
                            <TextBlock Name="ProjectNameTextBlock" Grid.Row="0" Grid.Column="1" Classes="MetadataValue" Margin="0,0,0,12" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="MetadataLabel" Margin="0,0,18,12" Text="Wersja" />
                            <TextBlock Name="ApplicationVersionTextBlock" Grid.Row="1" Grid.Column="1" Classes="MetadataValue" Margin="0,0,0,12" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="MetadataLabel" Margin="0,0,18,12" Text="Tester" />
                            <TextBlock Name="TesterNameTextBlock" Grid.Row="2" Grid.Column="1" Classes="MetadataValue" Margin="0,0,0,12" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="MetadataLabel" Margin="0,0,18,12" Text="Rodzaj sesji" />
                            <TextBlock Name="SessionModeTextBlock" Grid.Row="3" Grid.Column="1" Classes="MetadataValue" Margin="0,0,0,12" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Classes="MetadataLabel" Margin="0,0,18,12" Text="Ostatni test" />
                            <TextBlock Name="LastTestTextBlock" Grid.Row="4" Grid.Column="1" Classes="MetadataValue" Margin="0,0,0,12" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Classes="MetadataLabel" Margin="0,0,18,0" Text="Ostatni zapis" />
                            <TextBlock Name="LastSaveTextBlock" Grid.Row="5" Grid.Column="1" Classes="MetadataValue" />

                        </Grid>

                    </Border>

                    <Border
                        Padding="14"
                        Background="{DynamicResource IconBackgroundBrush}"
                        CornerRadius="12">

                        <TextBlock
                            Text="Wybranie „Nie teraz” nie usunie wyników. Sesja pozostanie zapisana i będzie można wrócić do niej później."
                            TextWrapping="Wrap"
                            FontSize="{DynamicResource AppFontSize12}"
                            LineHeight="18"
                            Foreground="{DynamicResource SecondaryTextBrush}" />

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <Grid
                Grid.Row="2"
                ColumnDefinitions="*,Auto,Auto">

                <Button
                    Grid.Column="1"
                    Classes="DialogButton Secondary"
                    Margin="0,0,10,0"
                    Content="NIE TERAZ"
                    Click="DismissButton_OnClick" />

                <Button
                    Grid.Column="2"
                    Classes="DialogButton Primary"
                    Content="KONTYNUUJ"
                    Click="ContinueButton_OnClick" />

            </Grid>

        </Grid>

    </Border>

</Window>
