<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="QARegressionManager.Views.BusyOperationWindow"
    Title="{DynamicResource Common.OperationInProgress}"
    Width="440"
    Height="245"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner"
    Background="Transparent">

    <Border
        Margin="12"
        Padding="30"
        Background="{DynamicResource CardBackgroundBrush}"
        BorderBrush="{DynamicResource CardBorderBrush}"
        BorderThickness="1"
        CornerRadius="22"
        BoxShadow="0 14 34 0 #42000000">

        <Grid RowDefinitions="Auto,Auto,Auto">

            <TextBlock
                Name="TitleTextBlock"
                Text="{DynamicResource Common.PleaseWait}"
                HorizontalAlignment="Center"
                FontSize="{DynamicResource AppFontSize23}"
                FontWeight="Bold"
                Foreground="{DynamicResource PrimaryTextBrush}" />

            <TextBlock
                Name="MessageTextBlock"
                Grid.Row="1"
                Margin="0,12,0,22"
                Text="{DynamicResource Common.SavingChanges}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                FontSize="{DynamicResource AppFontSize14}"
                Foreground="{DynamicResource SecondaryTextBrush}" />

            <ProgressBar
                Grid.Row="2"
                Height="8"
                IsIndeterminate="True"
                Foreground="{DynamicResource AccentPrimaryBrush}"
                Background="{DynamicResource AppBackgroundBrush}" />

        </Grid>

    </Border>

</Window>
