<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QARegressionManager.Views.AssignmentCompletionConfirmationWindow"
        Title="{DynamicResource Assignment.CompletionWindowTitle}"
        Width="720" Height="450" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Margin="20" Padding="28"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="22">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <Border Grid.Row="0" Width="62" Height="62" HorizontalAlignment="Left"
                    Background="#2028C76F" CornerRadius="18">
                <TextBlock Text="✓" FontSize="{DynamicResource AppFontSize31}" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#28C76F" />
            </Border>
            <TextBlock Grid.Row="1" Margin="0,18,0,0"
                       Text="{DynamicResource Assignment.CompletionQuestion}"
                       FontSize="{DynamicResource AppFontSize24}" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Grid.Row="2" Margin="0,10,0,0"
                       Text="{DynamicResource Assignment.CompletionInfo}"
                       TextWrapping="Wrap" FontSize="{DynamicResource AppFontSize14}"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <StackPanel Grid.Row="4" Margin="0,26,0,0" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="10">
                <Button Height="44" MinWidth="130" Padding="18,0" CornerRadius="11"
                        Content="{DynamicResource Common.Cancel}" Click="CancelButton_OnClick"
                        Background="{DynamicResource InputBackgroundBrush}"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}" />
                <Button Height="44" MinWidth="185" Padding="18,0" CornerRadius="11"
                        Content="{DynamicResource Assignment.ReportAndFinish}" Click="FinishWithReportButton_OnClick"
                        Background="#397FCA" Foreground="White" BorderBrush="#397FCA"
                        FontWeight="SemiBold" />
                <Button Height="44" MinWidth="185" Padding="18,0" CornerRadius="11"
                        Content="{DynamicResource Assignment.FinishAndSubmit}" Click="FinishButton_OnClick"
                        Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource AccentPrimaryBrush}"
                        FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
