<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="QARegressionManager.Views.ResetStatusesWindow"
    Title="{DynamicResource ResetStatuses.Title}"
    Width="600"
    Height="650"
    MinWidth="520"
    MinHeight="560"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppBackgroundBrush}">

    <Window.Styles>

        <Style Selector="Border.SettingsSection">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style Selector="RadioButton">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8,1,8,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="RadioButton:pointerover">
            <Setter Property="Background"
                    Value="{DynamicResource HoverItemBrush}" />
        </Style>

        <Style Selector="Button.DialogButton">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.DialogButton.Secondary">
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.DialogButton.Secondary:pointerover">
            <Setter Property="Background"
                    Value="{DynamicResource HoverItemBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputHoverBorderBrush}" />
        </Style>

        <Style Selector="Button.DialogButton.Primary">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.DialogButton.Primary:pointerover">
            <Setter Property="Background" Value="#3AD47A" />
            <Setter Property="BorderBrush" Value="#3AD47A" />
        </Style>

        <Style Selector="Button.DialogButton.Primary:pressed">
            <Setter Property="Background" Value="#169B50" />
            <Setter Property="BorderBrush" Value="#169B50" />
        </Style>

    </Window.Styles>

    <Border
        Margin="20"
        Padding="28"
        Background="{DynamicResource CardBackgroundBrush}"
        BorderBrush="{DynamicResource CardBorderBrush}"
        BorderThickness="1"
        CornerRadius="22">

        <Grid RowDefinitions="Auto,*,Auto">

            <StackPanel
                Grid.Row="0"
                Spacing="7">

                <TextBlock
                    Text="{DynamicResource ResetStatuses.Title}"
                    FontSize="{DynamicResource AppFontSize26}"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock
                    Text="{DynamicResource ResetStatuses.Description}"
                    FontSize="{DynamicResource AppFontSize15}"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource SecondaryTextBrush}" />

            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                Margin="0,24,0,18"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <StackPanel
                    Margin="0,0,8,0"
                    Spacing="14">

                    <Border Classes="SettingsSection">

                        <StackPanel Spacing="6">

                            <TextBlock
                                Text="{DynamicResource ResetStatuses.Scope}"
                                Margin="8,0,0,2"
                                FontSize="{DynamicResource AppFontSize12}"
                                FontWeight="Bold"
                                Foreground="{DynamicResource SecondaryTextBrush}" />

                            <RadioButton
                                Name="AllProjectRadioButton"
                                Content="{DynamicResource ResetStatuses.EntireProject}"
                                GroupName="Scope"
                                IsChecked="True" />

                            <StackPanel
                                Name="ScopeOptionsStackPanel"
                                Spacing="2" />

                        </StackPanel>

                    </Border>

                    <Border Classes="SettingsSection">

                        <StackPanel Spacing="6">

                            <TextBlock
                                Text="{DynamicResource ResetStatuses.NewStatus}"
                                Margin="8,0,0,2"
                                FontSize="{DynamicResource AppFontSize12}"
                                FontWeight="Bold"
                                Foreground="{DynamicResource SecondaryTextBrush}" />

                            <RadioButton
                                Name="PendingRadioButton"
                                Content="{DynamicResource ResetStatuses.Pending}"
                                GroupName="Status"
                                IsChecked="True" />

                            <RadioButton
                                Name="InProgressRadioButton"
                                Content="{DynamicResource ResetStatuses.InProgress}"
                                GroupName="Status" />

                        </StackPanel>

                    </Border>

                    <Border Classes="SettingsSection">

                        <StackPanel Spacing="6">

                            <TextBlock
                                Text="{DynamicResource ResetStatuses.WhichCases}"
                                Margin="8,0,0,2"
                                FontSize="{DynamicResource AppFontSize12}"
                                FontWeight="Bold"
                                Foreground="{DynamicResource SecondaryTextBrush}" />

                            <RadioButton
                                Name="AllCasesRadioButton"
                                Content="{DynamicResource ResetStatuses.AllCases}"
                                GroupName="Cases"
                                IsChecked="True" />

                            <RadioButton
                                Name="PendingAndNaRadioButton"
                                Content="{DynamicResource ResetStatuses.PendingAndNa}"
                                GroupName="Cases" />

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <Grid
                Grid.Row="2"
                ColumnDefinitions="*,Auto,Auto">

                <Button
                    Grid.Column="1"
                    Classes="DialogButton Secondary"
                    Margin="0,0,10,0"
                    Content="{DynamicResource Common.Cancel}"
                    Click="CancelButton_OnClick" />

                <Button
                    Grid.Column="2"
                    Classes="DialogButton Primary"
                    Content="{DynamicResource ResetStatuses.Apply}"
                    Click="ApplyButton_OnClick" />

            </Grid>

        </Grid>

    </Border>

</Window>
