<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="QARegressionManager.Views.OperationResultWindow"
    Title="{DynamicResource Common.OperationResult}"
    Width="520"
    Height="350"
    MinWidth="500"
    MinHeight="330"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppBackgroundBrush}">

    <Window.Styles>

        <Style Selector="Button.Primary">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="125" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>

    </Window.Styles>

    <Border
        Margin="20"
        Padding="28"
        Background="{DynamicResource CardBackgroundBrush}"
        BorderBrush="{DynamicResource CardBorderBrush}"
        BorderThickness="1"
        CornerRadius="22">

        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <Border
                Name="ResultIconBorder"
                Grid.Row="0"
                Width="60"
                Height="60"
                HorizontalAlignment="Left"
                Background="#2428C76F"
                CornerRadius="18">

                <TextBlock
                    Name="ResultIconTextBlock"
                    Text="✓"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource AppFontSize30}"
                    FontWeight="Bold"
                    Foreground="#19944D" />

            </Border>

            <TextBlock
                Name="TitleTextBlock"
                Grid.Row="1"
                Margin="0,18,0,10"
                Text="{DynamicResource Common.OperationCompleted}"
                TextWrapping="Wrap"
                MaxWidth="424"
                FontSize="{DynamicResource AppFontSize23}"
                FontWeight="Bold"
                Foreground="{DynamicResource PrimaryTextBrush}" />

            <TextBlock
                Name="MessageTextBlock"
                Grid.Row="2"
                TextWrapping="Wrap"
                FontSize="{DynamicResource AppFontSize14}"
                Foreground="{DynamicResource SecondaryTextBrush}" />

            <Button
                Grid.Row="3"
                Classes="Primary"
                HorizontalAlignment="Right"
                Content="OK"
                Click="OkButton_OnClick" />

        </Grid>

    </Border>

</Window>
