<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QARegressionManager.Views.AdminTestMenuWindow" Title="Menu testowe"
        Width="720" Height="860" MinWidth="640" MinHeight="720" CanResize="True"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Window.Styles>
        <Style Selector="Button.DialogButton"><Setter Property="Height" Value="42" /><Setter Property="Padding" Value="18,0" /><Setter Property="CornerRadius" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="Button.DialogButton.Primary"><Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" /><Setter Property="Foreground" Value="White" /></Style>
        <Style Selector="Button.DialogButton.Danger"><Setter Property="Background" Value="#DC4C56" /><Setter Property="Foreground" Value="White" /></Style>
        <Style Selector="Button.DialogButton.Secondary"><Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style Selector="Border.ManagementCard"><Setter Property="Padding" Value="16" /><Setter Property="Background" Value="{DynamicResource IconBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" /><Setter Property="BorderThickness" Value="1,0,1,1" /><Setter Property="CornerRadius" Value="0,0,12,12" /></Style>
        <Style Selector="Button.ResetTile"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="16,12" /><Setter Property="Background" Value="#18DC4C56" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="BorderBrush" Value="#DC4C56" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Cursor" Value="Hand" /></Style>
        <Style Selector="Button.ResetTile:pointerover"><Setter Property="Background" Value="#2ADC4C56" /><Setter Property="BorderBrush" Value="#F0646D" /></Style>
        <Style Selector="Button.ManagementAccordion"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Height" Value="62" /><Setter Property="Padding" Value="16,0" /><Setter Property="Background" Value="{DynamicResource IconBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12,12,0,0" /><Setter Property="Cursor" Value="Hand" /></Style>
        <Style Selector="Button.ManagementAccordion:pointerover"><Setter Property="Background" Value="{DynamicResource HoverItemBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" /></Style>
    </Window.Styles>
    <Border Margin="20" Padding="26" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="20">
        <StackPanel Spacing="0">
                <TextBlock Text="Menu testowe" FontSize="{DynamicResource AppFontSize26}" FontWeight="Bold" />
                <TextBlock Name="AccessDescriptionTextBlock" Text="Zarządzaj projektami od strony ich ról albo wybierz konto i sprawdź jego uprawnienia."
                           Margin="0,0,0,4" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />

                <Button Classes="ManagementAccordion" Click="ToggleProjectManagementButton_OnClick">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="ZARZĄDZANIE PROJEKTAMI" FontWeight="Bold" />
                            <TextBlock Text="Projekt → role → członkowie" FontSize="{DynamicResource AppFontSize11}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <TextBlock Name="ProjectManagementChevronTextBlock" Grid.Column="1" Text="⌄"
                                   VerticalAlignment="Center" FontSize="20" />
                    </Grid>
                </Button>

                <Border Name="ProjectManagementDetailsPanel" Classes="ManagementCard" IsVisible="False">
                    <StackPanel Spacing="9">
                        <TextBlock Text="WYBIERZ PROJEKT" FontWeight="Bold" />
                        <ComboBox Name="QuickProjectComboBox" Height="42" PlaceholderText="Wybierz projekt"
                                  SelectionChanged="QuickProjectComboBox_OnSelectionChanged" />
                        <StackPanel Name="QuickProjectActionsPanel" Spacing="9" IsVisible="False">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="ROLE W PROJEKCIE" FontWeight="Bold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Height="34" Padding="12,0" Content="+ DODAJ ROLĘ"
                                        Click="AddRoleToQuickProjectButton_OnClick" />
                            </Grid>
                            <Border Padding="8" Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="9">
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Name="QuickProjectRolesPanel" Spacing="5" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                        <Border Height="1" Margin="0,3" Background="{DynamicResource CardBorderBrush}" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Name="ShowQuickProjectCreationButton" Classes="DialogButton Secondary"
                                    Height="32" Padding="10,0" FontSize="{DynamicResource AppFontSize12}"
                                    HorizontalAlignment="Left" Content="+ NOWY PROJEKT"
                                    Click="ShowQuickProjectCreationButton_OnClick" />
                            <Button Grid.Column="2" Classes="DialogButton Danger"
                                    Height="32" Padding="10,0" FontSize="{DynamicResource AppFontSize12}"
                                    HorizontalAlignment="Right" Content="USUŃ PROJEKT"
                                    Click="DeleteQuickProjectButton_OnClick" />
                        </Grid>
                        <Grid Name="QuickProjectCreationPanel" ColumnDefinitions="*,8,Auto,8,Auto" IsVisible="False">
                            <TextBox Name="QuickProjectNameTextBox" Height="42" PlaceholderText="Nazwa nowego projektu" />
                            <Button Grid.Column="2" Classes="DialogButton Primary" Content="UTWÓRZ"
                                    Click="CreateQuickProjectButton_OnClick" />
                            <Button Grid.Column="4" Classes="DialogButton Secondary" Content="ANULUJ"
                                    Click="CancelQuickProjectCreationButton_OnClick" />
                        </Grid>
                        <TextBlock Name="QuickProjectResultTextBlock" TextWrapping="Wrap" IsVisible="False" />
                    </StackPanel>
                </Border>

                <Button Name="AccountManagementPanel" Classes="ManagementAccordion" Margin="0,12,0,0"
                        Click="ToggleAccountManagementButton_OnClick">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="ZARZĄDZANIE KONTAMI" FontWeight="Bold" />
                            <TextBlock Text="Konto → podgląd ról, PIN i usuwanie" FontSize="{DynamicResource AppFontSize11}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <TextBlock Name="AccountManagementChevronTextBlock" Grid.Column="1" Text="⌄"
                                   VerticalAlignment="Center" FontSize="20" />
                    </Grid>
                </Button>

                <Border Name="AccountManagementDetailsPanel" Classes="ManagementCard" IsVisible="False">
                    <StackPanel Spacing="9">
                        <TextBlock Text="WYBIERZ KONTO" FontWeight="Bold" />
                        <ComboBox Name="ProfileComboBox" Height="42" PlaceholderText="Wybierz profil użytkownika" />
                        <StackPanel Name="SelectedProfileActionsPanel" Spacing="9" IsVisible="False">
                            <TextBlock Text="POSIADANE ROLE" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold" />
                            <WrapPanel Name="OwnedRolesPanel" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="DialogButton Secondary" Content="RESETUJ PIN" Click="ResetSelectedButton_OnClick" />
                                <Button Name="DeleteSelectedUserButton" Classes="DialogButton Danger" Content="USUŃ KONTO"
                                        Click="DeleteSelectedUserButton_OnClick" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Name="NewAccountActionPanel" Margin="16,8,16,0" Padding="12"
                        IsVisible="False" Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid ColumnDefinitions="Auto,10,*">
                            <Button Name="ShowNewUserFormButton" Classes="DialogButton Primary" Content="+ DODAJ KONTO"
                                    Click="ShowNewUserFormButton_OnClick" />
                            <Grid Name="NewUserFormPanel" Grid.Column="2" ColumnDefinitions="*,8,Auto,8,Auto" IsVisible="False">
                                <TextBox Name="NewUserLoginTextBox" Height="42" PlaceholderText="Login nowego użytkownika" />
                                <Button Grid.Column="2" Classes="DialogButton Primary" Content="UTWÓRZ" Click="AddUserButton_OnClick" />
                                <Button Grid.Column="4" Classes="DialogButton Secondary" Content="ANULUJ" Click="CancelNewUserButton_OnClick" />
                            </Grid>
                        </Grid>
                </Border>

                <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                    <TextBlock Name="ResultTextBlock" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="False" />
                    <Button Grid.Column="1" Classes="DialogButton Secondary" Content="ZAMKNIJ" Click="CloseButton_OnClick" />
                </Grid>
        </StackPanel>
    </Border>
</Window>
