<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="QARegressionManager.Views.AssignmentArchiveWindow"
    Title="Archiwum sesji testowych"
    Width="860"
    Height="680"
    MinWidth="680"
    MinHeight="480"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppBackgroundBrush}">

    <Window.Styles>
        <Style Selector="Button.ArchiveButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Border Margin="20" Padding="26"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="22">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <TextBlock Grid.Row="0" Text="Archiwum sesji testowych"
                       FontSize="{DynamicResource AppFontSize26}" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Grid.Row="1" Margin="0,6,0,18"
                       Text="Sesje przeniesione z historii. Pozycje są automatycznie usuwane po 60 dniach. Można je wcześniej przywrócić do historii albo usunąć trwale."
                       TextWrapping="Wrap" FontSize="{DynamicResource AppFontSize13}"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <CheckBox Grid.Row="2" Name="SelectAllCheckBox" Margin="2,0,0,12"
                      Content="Zaznacz wszystkie" Click="SelectAllCheckBox_OnClick" />
            <Border Grid.Row="3" Padding="12"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="ArchivedSessionsPanel" Spacing="9" />
                </ScrollViewer>
            </Border>
            <Grid Grid.Row="4" Margin="0,18,0,0" ColumnDefinitions="*,Auto,10,Auto,10,Auto">
                <TextBlock Name="ArchiveResultTextBlock" Grid.Column="0"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <Button Grid.Column="1" Classes="ArchiveButton"
                        Content="ZAMKNIJ" Click="CloseButton_OnClick"
                        Background="{DynamicResource InputBackgroundBrush}"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}" />
                <Button Grid.Column="3" Name="DeleteSelectedButton" Classes="ArchiveButton"
                         Content="USUŃ ZAZNACZONE" Click="DeleteSelectedButton_OnClick"
                         Background="#DC4C56" Foreground="White" BorderBrush="#DC4C56" />
                <Button Grid.Column="5" Name="DeleteAllButton" Classes="ArchiveButton"
                        Content="USUŃ WSZYSTKO" Click="DeleteAllButton_OnClick"
                        Background="#B93643" Foreground="White" BorderBrush="#B93643" />
            </Grid>
        </Grid>
    </Border>
</Window>
